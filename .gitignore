# =============================================================================
# AmCart Monorepo .gitignore
# =============================================================================

# ----- OS Files -----
.DS_Store
Thumbs.db
Desktop.ini

# ----- IDE / Editor -----
.idea/
*.iml
.vscode/
*.swp
*.swo
*~
.project
.classpath
.settings/

# ----- Java / Spring Boot -----
target/
*.class
*.jar
*.war
*.ear
hs_err_pid*
replay_pid*

# ----- Gradle -----
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar

# ----- Maven -----
.mvn/repository/

# ----- Node.js / Next.js -----
node_modules/
.next/
out/
.turbo/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ----- Environment / Secrets -----
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key

# ----- Terraform -----
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# ----- Docker -----
docker-compose.override.yml

# ----- Python (for utility scripts) -----
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
*.egg-info/

# ----- Logs -----
logs/
*.log

# ----- Runtime / Dev Server Artifacts -----
.codex-dev-server*
*.pid

# ----- Archives / Large Files -----
*.zip
*.tar.gz
*.rar

# ----- Coverage / Test Reports -----
coverage/
*.lcov
test-results/
surefire-reports/
