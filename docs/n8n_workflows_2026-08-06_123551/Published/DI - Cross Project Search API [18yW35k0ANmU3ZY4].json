      "parameters": {
        "jsCode": "const headers = $json.headers || {};\nconst authHeader = headers.authorization || headers.Authorization || '';\nconst query = $json.query || {};\nif (!String(authHeader).toLowerCase().startsWith('bearer ')) return [{ json: { ok: false, statusCode: 401, errorCode: 'UNAUTHORIZED', message: 'Missing bearer token' } }];\nreturn [{ json: { ok: true, token: String(authHeader).replace(/^Bearer\\s+/i, ''), q: String(query.q || '').trim(), projectId: query.projectId || query.project_id || null, limit: Math.min(Number(query.limit || 25), 100) } }];"
