    {
      "parameters": {
        "jsCode": "const auth = $('Verify Search Supabase Auth User').first().json || {};\nconst rawProfile = $('Fetch Search Q-Ops User Profile').first().json;\nconst profile = Array.isArray(rawProfile) ? rawProfile[0] : rawProfile;\nif (!auth.id) return [{ json: { ok: false, statusCode: 401, errorCode: 'UNAUTHORIZED', message: 'Invalid Supabase Auth token' } }];\nif (!profile?.id || profile.status !== 'active') return [{ json: { ok: false, statusCode: 403, errorCode: 'PROFILE_NOT_ACTIVE', message: 'Active Q-Ops user profile not found' } }];\nconst req = $('Prepare DI Search Request').first().json;\nconst q = String(req.q || '').toLowerCase();\nconst limit = req.limit || 25;\nconst memberships = $items('Fetch Search Project Memberships').map(i => i.json.project_id).filter(Boolean);\nconst isAdmin = profile.role === 'admin';\nconst canProject = id => isAdmin || !id || memberships.includes(id);\nconst visible = r => isAdmin || ['organization','ai_sanitized_only'].includes(r.visibility_level) || canProject(r.source_project_id || r.project_id);\nconst matches = (r, fields) => !q || fields.some(f => String(r[f] || '').toLowerCase().includes(q)) || JSON.stringify(r).toLowerCase().includes(q);\nconst solutions = $items('Fetch DI Solutions For Search').map(i => i.json).filter(r => r && r.id && visible(r) && matches(r, ['title','summary','problem_statement','implementation_approach','qa_approach'])).slice(0, limit).map(r => ({ type: 'solution', id: r.id, title: r.title, summary: r.summary, projectId: r.source_project_id, visibilityLevel: r.visibility_level, status: r.status, updatedAt: r.updated_at }));\nconst technologies = $items('Fetch DI Technologies For Search').map(i => i.json).filter(r => r && r.id && matches(r, ['name','normalized_name','category','description','vendor'])).slice(0, limit).map(r => ({ type: 'technology', id: r.id, title: r.name, summary: r.description || r.category, category: r.category, updatedAt: r.updated_at }));\nconst learnings = $items('Fetch DI Learnings For Search').map(i => i.json).filter(r => r && r.id && visible(r) && matches(r, ['title','category','learning_summary','reusable_recommendation'])).slice(0, limit).map(r => ({ type: 'learning', id: r.id, title: r.title, summary: r.learning_summary, projectId: r.source_project_id, impactLevel: r.impact_level, createdAt: r.created_at }));\nconst recommendations = $items('Fetch DI Recommendations For Search').map(i => i.json).filter(r => r && r.id && canProject(r.project_id) && matches(r, ['title','summary','rationale','recommendation_type'])).slice(0, limit).map(r => ({ type: 'recommendation', id: r.id, title: r.title, summary: r.summary, projectId: r.project_id, status: r.status, confidenceScore: r.confidence_score, createdAt: r.created_at }));\nconst results = [...solutions, ...technologies, ...learnings, ...recommendations].slice(0, limit * 4);\nreturn [{ json: { ok: true, query: req.q, projectId: req.projectId, counts: { solutions: solutions.length, technologies: technologies.length, learnings: learnings.length, recommendations: recommendations.length, total: results.length }, results } }];"
      },
