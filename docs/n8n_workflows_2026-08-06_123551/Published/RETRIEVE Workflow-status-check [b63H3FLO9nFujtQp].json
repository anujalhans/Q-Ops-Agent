    {
      "parameters": {
        "jsCode": "const inputJobId = $input.first().json.jobId;\n\n// Handle both array and object responses\nlet record = Array.isArray($json) ? $json[0] : $json;\n\nif (!record || !record.job_id) {\n  return [\n    {\n      json: {\n        jobId: inputJobId,\n        status: \"not_found\",\n        output: null\n      }\n    }\n  ];\n}\n\n// 🔥 Ensure output is ALWAYS either null OR object (never string)\nlet output = record.output ?? null;\n\n// Optional safety (only if your DB might accidentally store stringified JSON)\nif (typeof output === \"string\") {\n  try {\n    output = JSON.parse(output);\n  } catch (e) {\n    output = null;\n  }\n}\n\nreturn [\n  {\n    json: {\n      jobId: record.job_id,\n      status: record.status,\n      output: output\n    }\n  }\n];"
      },
