    {
      "parameters": {
        "jsCode": "const auth = $('Verify Supabase Auth User').first().json || {};\nconst admin = $items('Fetch Current Q-Ops Admin').map(i => i.json).find(r => r && r.id);\nconst target = $items('Fetch Target Q-Ops User').map(i => i.json).find(r => r && r.id);\nconst body = $('PATCH /users/project-assignments').first().json.body || {};\nconst rawAssignments = Array.isArray(body.projectAssignments) ? body.projectAssignments : Array.isArray(body.projects) ? body.projects : [];\nconst projectMap = new Map($items('Fetch Projects').map(i => i.json).filter(p => p && p.id).map(p => [String(p.id), p]));\nconst normalized = [];\nconst seen = new Set();\nfor (const item of rawAssignments) {\n  const projectId = String(typeof item === 'string' ? item : item.projectId || item.id || '').trim();\n  if (!projectId || seen.has(projectId)) continue;\n  seen.add(projectId);\n  const role = ['owner', 'editor', 'viewer'].includes(item.role || item.projectRole) ? (item.role || item.projectRole) : 'editor';\n  normalized.push({ project_id: projectId, user_id: String(body.userId || body.id || '').trim(), project_role: role, updated_at: new Date().toISOString() });\n}\nconst missingProjects = normalized.map(a => a.project_id).filter(id => !projectMap.has(id));\nconst authorized = Boolean(auth.id && admin && admin.role === 'admin' && admin.status === 'active' && target && target.id && target.role !== 'admin' && missingProjects.length === 0);\nconst message = !auth.id ? 'Missing or invalid Supabase Auth token.' : !admin ? 'Authenticated user is not registered in qops_users.' : admin.role !== 'admin' ? 'Admin role is required.' : admin.status !== 'active' ? 'Admin profile is not active.' : !target ? 'Target user was not found.' : target.role === 'admin' ? 'Admin users do not need project assignments.' : missingProjects.length ? 'One or more selected projects no longer exist.' : 'Authorized.';\nreturn [{ json: { authorized, message, target, admin, assignments: normalized, hasAssignments: normalized.length > 0, projectNames: normalized.map(a => projectMap.get(a.project_id)?.name || a.project_id), audit: { actor_user_id: admin?.id || null, actor_name: admin?.name || admin?.email || auth.email || 'unknown', action: 'USER_PROJECT_ASSIGNMENTS_UPDATED', entity_type: 'qops_user', entity_id: target?.id || String(body.userId || body.id || ''), status: authorized ? 'success' : 'error', details: authorized ? 'Updated project assignments for ' + (target?.email || target?.id) : message, metadata: { source: 'ui', targetUserId: target?.id || null, projectIds: normalized.map(a => a.project_id), projectRoles: normalized.map(a => ({ projectId: a.project_id, role: a.project_role })) } } } }];"
      },
