    {
      "parameters": {
        "jsCode": "const auth = $('Verify Supabase Auth User').first().json || {};\nconst admin = $items('Fetch Current Q-Ops User').map(i => i.json).find(r => r && r.id);\nconst body = $('PATCH /users/update').first().json.body || {};\nconst userId = String(body.userId || body.id || '').trim();\nconst payload = { updated_at: new Date().toISOString() };\nif (body.name !== undefined) payload.name = String(body.name || '').trim();\nif (body.title !== undefined) payload.title = String(body.title || '').trim() || null;\nif (body.role !== undefined) payload.role = body.role === 'admin' ? 'admin' : 'registered_user';\nif (body.status !== undefined) payload.status = ['active', 'pending_invite', 'disabled'].includes(body.status) ? body.status : 'active';\nconst changedKeys = Object.keys(payload).filter(k => k !== 'updated_at');\nconst authorized = Boolean(auth.id && admin && admin.role === 'admin' && admin.status === 'active' && userId && changedKeys.length);\nconst message = !auth.id ? 'Missing or invalid Supabase Auth token.' : !admin ? 'Authenticated user is not registered in qops_users.' : admin.role !== 'admin' ? 'Admin role is required.' : admin.status !== 'active' ? 'Admin profile is not active.' : !userId ? 'userId is required.' : !changedKeys.length ? 'No supported user fields were provided.' : 'Authorized.';\nreturn [{ json: { authorized, message, userId, payload, audit: { actor_user_id: admin?.id || null, actor_name: admin?.name || admin?.email || auth.email || 'unknown', action: 'USER_UPDATED', entity_type: 'qops_user', entity_id: userId, status: authorized ? 'success' : 'error', details: authorized ? `Updated user ${userId}` : message, metadata: { source: 'ui', userId, changedKeys } } } }];"
      },
