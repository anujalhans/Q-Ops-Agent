        "specifyHeaders": "json",
        "jsonHeaders": "={ \"apikey\": \"sb_publishable_SzDNzUTrzUb7lIBT3AuSvg_UD_jP9Gt\", \"Authorization\": \"{{ $json.headers.authorization || $json.headers.Authorization || $json.headers.Authorization || \"\" }}\" }",
        "options": {}
