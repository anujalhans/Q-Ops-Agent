    {
      "id": "75757d7a-6907-43d3-9f87-a221c3af857d",
      "name": "Map Current User Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        0
      ],
      "parameters": {
        "jsCode": "const auth = $('Verify Supabase Auth User').first().json || {};\nconst profiles = $items('Fetch Q-Ops User Profile').map(i => i.json).filter(r => r && r.id);\nconst profile = profiles[0];\nif (!auth.id) return [{ json: { ok: false, error: 'unauthorized', message: 'Missing or invalid Supabase Auth token.' } }];\nif (!profile) return [{ json: { ok: false, error: 'profile_not_found', message: 'Authenticated user is not registered in qops_users.' } }];\nconst memberships = $items('Fetch Current User Project Memberships').map(i => i.json).filter(r => r && r.project_id);\nconst projectRoles = profile.role === 'admin' ? [] : memberships.map(r => ({ projectId: r.project_id, role: r.project_role || 'viewer' }));\nconst projects = profile.role === 'admin' ? ['All projects'] : projectRoles.map(r => r.projectId);\nconst permissions = profile.role === 'admin' ? ['users:read', 'users:invite', 'users:update', 'settings:write', 'projects:read', 'projects:write'] : ['settings:read', 'projects:read'];\nreturn [{ json: { id: profile.id, authUserId: profile.auth_user_id || auth.id, email: profile.email || auth.email, name: profile.name || auth.email, title: profile.title, avatarUrl: profile.avatar_url, role: profile.role, status: profile.status, lastLoginAt: profile.last_login_at, permissions, projects, projectRoles } }];"
      }
    },
    {
      "id": "be9e54cd-f599-4149-875f-2201b9f208ce",
      "name": "Respond Current User",
