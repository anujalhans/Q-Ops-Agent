      {
        "parameters": {
          "jsCode": "const authUser = $('Verify Supabase Auth User').first().json || {};\nconst profile = $('Fetch Q-Ops User Profile').first().json || {};\nconst memberships = $items('Fetch Current User Project Memberships').map(i => i.json).filter(m => m && m.project_id);\n\nif (!authUser.id || !profile.id || profile.status !== 'active') {\n  return [{ json: { ok: false, error: 'unauthorized', message: 'Missing or invalid Supabase Auth token.' } }];\n}\n\nconst isAdmin = profile.role === 'admin';\nconst allowedProjectIds = new Set(memberships.map(m => String(m.project_id)));\nconst allowedProjectNames = new Set(memberships.map(m => m.qops_projects?.name).filter(Boolean).map(String));\nconst projectNameById = new Map(memberships.map(m => [String(m.project_id), m.qops_projects?.name || String(m.project_id)]));\nconst currentUserId = String(profile.id);\nconst actorKeys = new Set([profile.email, profile.name, authUser.email].filter(Boolean).map(v => String(v).toLowerCase()));\n\nfunction isOwnAuditEvent(e) {\n  if (isAdmin) return true;\n  const meta = e.metadata || {};\n  const projectId = e.project_id ? String(e.project_id) : '';\n  const projectName = meta.projectName || meta.project_name || '';\n  const actor = String(e.actor_name || '').toLowerCase();\n  const requestedBy = meta.requested_by || meta.requestedBy || meta.userId || meta.qopsUserId;\n  return Boolean(\n    (projectId && allowedProjectIds.has(projectId)) ||\n    (projectName && allowedProjectNames.has(String(projectName))) ||\n    (requestedBy && String(requestedBy) === currentUserId) ||\n    (actor && actorKeys.has(actor))\n  );\n}\n\nfunction isOwnMetric(m) {\n  if (isAdmin) return true;\n  const requestedByMatches = m.requested_by && String(m.requested_by) === currentUserId;\n  const projectId = m.project_id ? String(m.project_id) : '';\n  const projectName = m.project_name || '';\n  const assignedProjectMatches = !projectId || allowedProjectIds.has(projectId) || allowedProjectNames.has(String(projectName));\n  return Boolean(requestedByMatches && assignedProjectMatches);\n}\n\nconst explicitEvents = $items('Fetch Q-Ops Audit Events')\n  .map(i => i.json)\n  .filter(e => e && e.id && isOwnAuditEvent(e))\n  .map(e => ({\n    id: e.id,\n    actor: e.actor_name || 'n8n',\n    action: e.action,\n    project: e.metadata?.projectName || e.metadata?.project_name || (e.project_id ? projectNameById.get(String(e.project_id)) || e.project_id : ''),\n    entity: e.entity_id || e.entity_type || '',\n    status: e.status || 'info',\n    timestamp: e.created_at,\n    details: e.details || '',\n    event: e.action\n  }));\n\nconst metricEvents = $items('Fetch QA Job Metrics For Audit')\n  .map(i => i.json)\n  .filter(m => m && m.id && isOwnMetric(m))\n  .map(m => ({\n    id: `metric-${m.id}`,\n    actor: 'n8n',\n    action: m.event || 'JOB_EVENT',\n    project: m.project_name || (m.project_id ? projectNameById.get(String(m.project_id)) || m.project_id : ''),\n    entity: m.job_id || '',\n    status: m.status === 'error' || m.status === 'failed' ? 'error' : m.event === 'JOB_COMPLETED' ? 'success' : 'info',\n    timestamp: m.created_at,\n    details: [m.pipeline, m.document_type, m.error_message].filter(Boolean).join(' | '),\n    event: m.event,\n    pipeline: m.pipeline,\n    jobId: m.job_id\n  }));\n\nconst events = explicitEvents.concat(metricEvents).sort((a, b) => new Date(b.timestamp || 0) - new Date(a.timestamp || 0)).slice(0, 150);\nreturn [{ json: { events, meta: { scope: isAdmin ? 'workspace' : 'self', userId: profile.id, projectIds: isAdmin ? [] : Array.from(allowedProjectIds), generatedAt: new Date().toISOString() } } }];"
        },
