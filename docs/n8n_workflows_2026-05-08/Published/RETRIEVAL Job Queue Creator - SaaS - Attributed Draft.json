          }
        }
      },
      {
        "parameters": {
          "jsCode": "const runtimeRaw = $input.first().json || {};\nconst runtime = Array.isArray(runtimeRaw) ? runtimeRaw[0] : runtimeRaw;\nconst job = $('Prepare Runtime Request').first().json;\nconst settingsVersion = runtime.settingsVersion ?? runtime.settings_version ?? null;\nconst configSnapshot = runtime.configSnapshot ?? runtime.config_snapshot ?? {};\nreturn [{ json: { ...job, settingsVersion, configSnapshot } }];"
        },
