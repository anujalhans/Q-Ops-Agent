            "name": "supabase-service-role-key"
          }
        }
      },
      {
        "parameters": {
          "jsCode": "const profile = $input.first().json || {};\nif (!profile.id || profile.status !== 'active') throw new Error('Active Q-Ops user profile not found');\nconst job = $('Generate Job ID').first().json;\nreturn [{ json: { ...job, requestedBy: profile.id, qopsUser: profile, runtimeRequest: { p_environment_key: job.environment || 'local', p_project_id: job.projectId || null, p_pipeline: 'generation', p_requested_by: profile.id } } }];"
        },
