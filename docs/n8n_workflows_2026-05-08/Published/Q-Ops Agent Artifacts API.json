      {
        "id": "3acae756-92d2-4dbe-8b59-a969fd4f4240",
        "name": "Map Artifacts Response",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          448,
          0
        ],
        "parameters": {
          "jsCode": "const artifacts = []; const statusMap = { completed: 'processed', failed: 'failed', pending: 'processing', processing: 'processing' }; for (const item of $input.all()) { const job = item.json; if (!job || !job.job_id) continue; const input = job.input || {}; const files = input.files || {}; for (const [type, url] of Object.entries(files)) { const rawName = String(url).split('/').pop() || type; artifacts.push({ id: `${job.job_id}:${type}`, projectName: input.projectName || 'Unknown project', type, fileName: decodeURIComponent(rawName), uploadedAt: job.created_at, status: statusMap[job.status] || 'processing', url, jobId: job.job_id }); } } return [{ json: { artifacts } }];"
        }
      },
