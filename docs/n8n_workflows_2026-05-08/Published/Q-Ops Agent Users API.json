      {
        "id": "87c6231c-f9ab-494c-a2cd-a1a42508f1f0",
        "name": "Map Users Response",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          1120,
          0
        ],
        "parameters": {
          "jsCode": "const auth = $('Verify Supabase Auth User').first().json || {};\nconst current = $items('Fetch Current Q-Ops User').map(i => i.json).find(r => r && r.id);\nif (!auth.id) return [{ json: { ok: false, error: 'unauthorized', users: [] } }];\nif (!current || current.status !== 'active') return [{ json: { ok: false, error: 'profile_not_active', users: [] } }];\nif (current.role !== 'admin') return [{ json: { ok: false, error: 'forbidden', users: [] } }];\nconst memberships = $items('Fetch Project Memberships').map(i => i.json).filter(r => r && r.user_id);\nconst users = $items('Fetch Users').map(i => i.json).filter(r => r && r.id).map(user => {\n  const scoped = memberships.filter(member => member.user_id === user.id);\n  return {\n    id: user.id,\n    authUserId: user.auth_user_id,\n    email: user.email,\n    name: user.name || user.email,\n    title: user.title,\n    avatarUrl: user.avatar_url,\n    role: user.role,\n    status: user.status,\n    lastLoginAt: user.last_login_at,\n    createdAt: user.created_at,\n    updatedAt: user.updated_at,\n    projects: user.role === 'admin' ? ['All projects'] : scoped.map(member => member.project_id),\n    projectRoles: scoped.map(member => ({ projectId: member.project_id, role: member.project_role }))\n  };\n});\nreturn [{ json: { users } }];"
        }
      },
