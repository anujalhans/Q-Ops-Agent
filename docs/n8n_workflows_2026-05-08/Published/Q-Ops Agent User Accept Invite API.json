      {
        "parameters": {
          "jsCode": "const auth = $('Verify Supabase Auth User').first().json || {};\nconst user = $items('Fetch Invited Q-Ops User').map(i => i.json).find(r => r && r.id);\nconst authorized = Boolean(auth.id && auth.email && user && user.status !== 'disabled');\nconst message = !auth.id ? 'Missing or invalid Supabase Auth token.' : !user ? 'No matching Q-Ops invited user profile exists.' : user.status === 'disabled' ? 'This Q-Ops user profile is disabled.' : 'Authorized.';\nconst now = new Date().toISOString();\nreturn [{ json: { authorized, message, auth, user, patch: { auth_user_id: auth.id, status: 'active', updated_at: now, last_login_at: now }, audit: { actor_user_id: user?.id || null, actor_name: user?.name || user?.email || auth.email || 'unknown', action: 'USER_INVITE_ACCEPTED', entity_type: 'qops_user', entity_id: user?.id || auth.email || 'unknown', status: authorized ? 'success' : 'error', details: authorized ? `Accepted invite for ${user.email}` : message, metadata: { source: 'ui', email: auth.email || null, authUserId: auth.id || null } } } }];"
        },
