  "name": "Q-Ops Agent User Password Reset Audit API",
  "description": "POST /webhook/users/password-reset-audit verifies the Supabase bearer token, resolves the active Q-Ops profile, and writes PASSWORD_RESET_COMPLETED to qops_audit_events.",
  "active": true,
  "isArchived": false,
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "users/password-reset-audit",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "50314ec3-2473-4be0-8ee0-d3b4253839b8",
      "name": "POST /users/password-reset-audit",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        0,
        0
      ],
      "webhookId": "d397b36b-63af-40d0-b871-67e7515d5064"
    },
    {
      "parameters": {
        "jsCode": "const headers = $json.headers || {};\nconst body = $json.body || {};\nconst authHeader = headers.authorization || headers.Authorization || '';\nif (!String(authHeader).toLowerCase().startsWith('bearer ')) {\n  throw new Error('Missing bearer token');\n}\nreturn [{ json: { token: String(authHeader).replace(/^Bearer\\s+/i, ''), resetAt: body.resetAt || new Date().toISOString() } }];"
      },
      "id": "675e6258-19b2-4fab-b04a-61f78ea134c1",
      "name": "Prepare Audit Context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        0
      ]
    },
    {
      "parameters": {
        "url": "https://ifnznfspkjayhnooncrv.supabase.co/auth/v1/user",
        "sendHeaders": true,
        "specifyHeaders": "json",
        "jsonHeaders": "={ \"apikey\": \"sb_publishable_SzDNzUTrzUb7lIBT3AuSvg_UD_jP9Gt\", \"Authorization\": \"Bearer {{ $json.token }}\" }",
        "options": {}
      },
      "id": "6abab1fa-770c-4d92-853e-a604ff9297ce",
      "name": "Verify Supabase Auth User",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        448,
        0
      ]
    },
    {
      "parameters": {
        "url": "=https://ifnznfspkjayhnooncrv.supabase.co/rest/v1/qops_users?auth_user_id=eq.{{ $json.id }}&select=id,email,name,role,status",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpCustomAuth",
        "sendHeaders": true,
        "specifyHeaders": "json",
        "jsonHeaders": "{ \"Content-Type\": \"application/json\" }",
        "options": {}
      },
      "id": "ee0de144-e05f-4020-9741-13fc37f32b0c",
      "name": "Fetch Q-Ops User",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        672,
        0
      ],
      "alwaysOutputData": true,
      "credentials": {
        "httpCustomAuth": {
          "id": "DpZbhUxkEbKeXIiJ",
          "name": "supabase-service-role-key"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const authUser = $('Verify Supabase Auth User').first().json;\nconst context = $('Prepare Audit Context').first().json;\nconst profile = $input.first().json || {};\nif (!profile.id || profile.status !== 'active') {\n  throw new Error('Active Q-Ops user profile not found');\n}\nreturn [{ json: {\n  audit: {\n    actor_user_id: profile.id,\n    actor_name: profile.name || profile.email || authUser.email || 'Q-Ops user',\n    action: 'PASSWORD_RESET_COMPLETED',\n    entity_type: 'user',\n    entity_id: profile.id,\n    status: 'success',\n    details: 'User completed password reset from Q-Ops Agent UI',\n    metadata: { source: 'ui', authUserId: authUser.id, email: profile.email || authUser.email || null, role: profile.role || null, resetAt: context.resetAt }\n  },\n  response: { ok: true, userId: profile.id }\n} }];"
      },
      "id": "2f9f5ba0-fb4b-423b-b17e-3a9cb84a7866",
      "name": "Prepare Password Reset Audit Event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
