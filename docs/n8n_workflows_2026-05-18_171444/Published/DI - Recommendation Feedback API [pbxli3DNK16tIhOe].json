      "parameters": {
        "jsCode": "const updated = $('Update DI Recommendation Feedback').first().json || {};\nreturn [{ json: { ok: true, recommendationId: updated.id || $('Authorize DI Feedback').first().json.recommendationId, status: updated.status || $('Authorize DI Feedback').first().json.patch.status } }];"
