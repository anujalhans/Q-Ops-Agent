        "path": "di/recommendations/feedback",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "63c968e1-53bc-4a65-8113-8db5d317022f",
      "name": "PATCH /di/recommendations/feedback",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        0,
        144
      ],
      "webhookId": "5f144ff3-91a4-441b-922c-34d1cc856bc8"
    },
    {
      "parameters": {
        "jsCode": "const headers = $json.headers || {};\nconst authHeader = headers.authorization || headers.Authorization || '';\nconst body = $json.body || {};\nconst actionMap = { viewed: 'viewed', accept: 'accepted', accepted: 'accepted', dismiss: 'dismissed', dismissed: 'dismissed', convert: 'converted', converted: 'converted' };\nconst recommendationId = body.recommendationId || body.recommendation_id || body.id;\nconst action = actionMap[String(body.action || '').toLowerCase()];\nif (!String(authHeader).toLowerCase().startsWith('bearer ')) return [{ json: { ok: false, statusCode: 401, errorCode: 'UNAUTHORIZED', message: 'Missing bearer token' } }];\nif (!recommendationId || !action) return [{ json: { ok: false, statusCode: 400, errorCode: 'INVALID_FEEDBACK', message: 'recommendationId and valid action are required' } }];\nreturn [{ json: { ok: true, token: String(authHeader).replace(/^Bearer\\s+/i, ''), recommendationId, action, comment: body.comment || body.reason || '', feedback: body.feedback || {} } }];"
      },
