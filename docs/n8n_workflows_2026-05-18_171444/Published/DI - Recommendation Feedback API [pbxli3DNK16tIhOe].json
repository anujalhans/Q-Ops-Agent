    {
      "parameters": {
        "jsCode": "const auth = $('Verify Feedback Supabase Auth User').first().json || {};\nconst rawProfile = $('Fetch Feedback Q-Ops User Profile').first().json;\nconst profile = Array.isArray(rawProfile) ? rawProfile[0] : rawProfile;\nconst rawRec = $('Fetch DI Recommendation For Feedback').first().json;\nconst rec = Array.isArray(rawRec) ? rawRec[0] : rawRec;\nconst req = $('Prepare DI Feedback Request').first().json;\nif (!auth.id) return [{ json: { ok: false, statusCode: 401, errorCode: 'UNAUTHORIZED', message: 'Invalid Supabase Auth token' } }];\nif (!profile?.id || profile.status !== 'active') return [{ json: { ok: false, statusCode: 403, errorCode: 'PROFILE_NOT_ACTIVE', message: 'Active Q-Ops user profile not found' } }];\nif (!rec?.id) return [{ json: { ok: false, statusCode: 404, errorCode: 'RECOMMENDATION_NOT_FOUND', message: 'Recommendation not found' } }];\nconst memberships = $items('Fetch Feedback Project Memberships').map(i => i.json.project_id).filter(Boolean);\nconst canUpdate = profile.role === 'admin' || rec.assigned_to === profile.id || !rec.project_id || memberships.includes(rec.project_id);\nif (!canUpdate) return [{ json: { ok: false, statusCode: 403, errorCode: 'RECOMMENDATION_ACCESS_DENIED', message: 'User cannot update this recommendation' } }];\nconst previousFeedback = rec.feedback && typeof rec.feedback === 'object' ? rec.feedback : {};\nconst patch = { status: req.action, feedback: { ...previousFeedback, lastAction: req.action, comment: req.comment, updatedBy: profile.email, updatedByUserId: profile.id, updatedAt: new Date().toISOString(), details: req.feedback }, updated_at: new Date().toISOString() };\nconst audit = { action: `DI_RECOMMENDATION_${req.action.toUpperCase()}`, entity_type: 'di_recommendation', entity_id: rec.id, project_id: rec.project_id, actor_user_id: profile.id, actor_name: profile.email, status: 'success', details: `${req.action}: ${rec.title}`, metadata: { recommendation_id: rec.id, previous_status: rec.status, new_status: req.action, comment: req.comment } };\nreturn [{ json: { ok: true, recommendationId: rec.id, patch, audit } }];"
      },
