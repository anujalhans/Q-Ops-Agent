        "jsCode": "const headers = $json.headers || {};\nconst authHeader = headers.authorization || headers.Authorization || '';\nconst query = $json.query || {};\nconst jobId = query.jobId || query.job_id || '';\nif (!String(authHeader).toLowerCase().startsWith('bearer ')) return [{ json: { ok: false, statusCode: 401, errorCode: 'UNAUTHORIZED', message: 'Missing bearer token' } }];\nif (!jobId) return [{ json: { ok: false, statusCode: 400, errorCode: 'JOB_ID_REQUIRED', message: 'jobId query parameter is required' } }];\nreturn [{ json: { ok: true, token: String(authHeader).replace(/^Bearer\\s+/i, ''), jobId } }];"
