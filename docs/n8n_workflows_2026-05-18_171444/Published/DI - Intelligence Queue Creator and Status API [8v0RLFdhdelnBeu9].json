    {
      "parameters": {
        "jsCode": "const headers = $json.headers || {};\nconst authHeader = headers.authorization || headers.Authorization || '';\nconst body = $json.body || {};\nconst allowed = new Set(['project_intelligence_extract','solution_extract','technology_extract','relationship_build','recommendation_generate','semantic_reindex']);\nconst jobType = String(body.jobType || body.job_type || '').trim();\nconst projectId = body.projectId || body.project_id || null;\nconst keySource = body.idempotencyKey || body.idempotency_key || `${jobType}:${projectId || 'workspace'}:${JSON.stringify(body.input || body.payload || {})}`;\nconst safeKey = String(keySource).toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '').slice(0, 80) || Math.random().toString(36).slice(2, 10);\nconst datePart = new Date().toISOString().slice(2,10).replace(/-/g, '');\nconst jobId = body.jobId || body.job_id || `DI-${datePart}-${safeKey}`;\nif (!String(authHeader).toLowerCase().startsWith('bearer ')) return [{ json: { ok: false, statusCode: 401, errorCode: 'UNAUTHORIZED', message: 'Missing bearer token' } }];\nif (!allowed.has(jobType)) return [{ json: { ok: false, statusCode: 400, errorCode: 'INVALID_JOB_TYPE', message: 'Unsupported Delivery Intelligence job type' } }];\nif (!projectId && jobType !== 'semantic_reindex') return [{ json: { ok: false, statusCode: 400, errorCode: 'PROJECT_REQUIRED', message: 'projectId is required for this job type' } }];\nreturn [{ json: { ok: true, token: String(authHeader).replace(/^Bearer\\s+/i, ''), jobId, jobType, projectId, input: { ...(body.input || body.payload || body), jobType, projectId, idempotencyKey: keySource, source: 'di-ui' } } }];"
      },
