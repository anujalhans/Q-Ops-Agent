    {
      "parameters": {
        "jsCode": "const req = $('Prepare DI Queue Request').first().json;\nconst auth = $('Verify Queue Supabase Auth User').first().json || {};\nconst rawProfile = $('Fetch Queue Q-Ops User Profile').first().json;\nconst profile = Array.isArray(rawProfile) ? rawProfile[0] : rawProfile;\nconst memberships = $items('Fetch Queue Project Memberships').map(i => i.json).filter(r => r && r.project_id);\nif (!auth.id) return [{ json: { ok: false, statusCode: 401, errorCode: 'UNAUTHORIZED', message: 'Invalid Supabase Auth token' } }];\nif (!profile?.id || profile.status !== 'active') return [{ json: { ok: false, statusCode: 403, errorCode: 'PROFILE_NOT_ACTIVE', message: 'Active Q-Ops user profile not found' } }];\nconst isAdmin = profile.role === 'admin';\nconst hasProject = !req.projectId || memberships.some(m => m.project_id === req.projectId);\nif (!isAdmin && req.jobType === 'semantic_reindex') return [{ json: { ok: false, statusCode: 403, errorCode: 'ADMIN_REQUIRED', message: 'semantic_reindex requires admin role' } }];\nif (!isAdmin && !hasProject) return [{ json: { ok: false, statusCode: 403, errorCode: 'PROJECT_ACCESS_DENIED', message: 'User is not assigned to this project' } }];\nconst payload = { job_id: req.jobId, status: 'pending', job_type: req.jobType, project_id: req.projectId, requested_by: profile.id, input: req.input, output: { queuedAt: new Date().toISOString(), queuedBy: profile.email, source: 'di-ui' } };\nreturn [{ json: { ok: true, jobId: req.jobId, jobType: req.jobType, projectId: req.projectId, requestedBy: profile.id, payload } }];"
      },
