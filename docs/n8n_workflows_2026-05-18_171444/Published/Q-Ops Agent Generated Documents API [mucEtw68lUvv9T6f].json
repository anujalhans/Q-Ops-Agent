        0
      ],
      "parameters": {
        "jsCode": "const documents = $input.all().map(i => i.json).filter(j => j && j.job_id).map(j => ({ id: j.job_id, jobId: j.job_id, projectName: j.input?.projectName || 'Unknown project', documentType: j.input?.documentType || '', artifactLabel: j.input?.documentType || '', createdAt: j.created_at, status: j.status, url: j.output?.url || j.output?.confluenceUrl || '', output: j.output || null })); return [{ json: { documents } }];"
      }
