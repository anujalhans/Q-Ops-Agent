    },
    {
      "id": "ebe4f857-7f24-404c-a194-c470dc9d68c2",
      "name": "Fetch Current Q-Ops User",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        448,
        96
      ],
      "parameters": {
        "url": "https://ifnznfspkjayhnooncrv.supabase.co/rest/v1/qops_users",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpCustomAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "select",
              "value": "id,auth_user_id,email,name,role,status"
            },
            {
              "name": "or",
              "value": "=({{ $json.id ? \"auth_user_id.eq.\" + $json.id + \",email.eq.\" + $json.email : \"email.eq.__missing__\" }})"
            },
            {
              "name": "limit",
              "value": "1"
            }
          ]
        },
        "sendHeaders": true,
        "specifyHeaders": "json",
        "jsonHeaders": "{ \"Content-Type\": \"application/json\" }",
        "options": {}
      },
      "credentials": {
        "httpCustomAuth": {
          "id": "DpZbhUxkEbKeXIiJ",
          "name": "supabase-service-role-key"
        }
      },
      "alwaysOutputData": true
    },
    {
      "id": "690f8a06-bec6-42cf-91f8-aa56b27afeeb",
      "name": "Prepare Invite Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        96
      ],
      "parameters": {
        "jsCode": "const auth = $('Verify Supabase Auth User').first().json || {};\nconst admin = $items('Fetch Current Q-Ops User').map(i => i.json).find(r => r && r.id);\nconst body = $('POST /users/invite').first().json.body || {};\nconst email = String(body.email || '').trim().toLowerCase();\nconst role = body.role === 'admin' ? 'admin' : 'registered_user';\nconst status = 'pending_invite';\nconst name = String(body.name || email.split('@')[0] || 'Invited User').trim();\nconst title = String(body.title || '').trim() || null;\nconst redirectTo = String(body.redirectTo || body.redirect_to || 'http://127.0.0.1:5175/auth/callback').trim();\nconst authorized = Boolean(auth.id && admin && admin.role === 'admin' && admin.status === 'active' && email);\nconst message = !auth.id ? 'Missing or invalid Supabase Auth token.' : !admin ? 'Authenticated user is not registered in qops_users.' : admin.role !== 'admin' ? 'Admin role is required.' : admin.status !== 'active' ? 'Admin profile is not active.' : !email ? 'Email is required.' : 'Authorized.';\nreturn [{ json: { authorized, message, auth, admin, invite: { email, redirect_to: redirectTo, data: { full_name: name, qops_role: role } }, qopsUser: { email, name, title, role, status, updated_at: new Date().toISOString() }, audit: { actor_user_id: admin?.id || null, actor_name: admin?.name || admin?.email || auth.email || 'unknown', action: 'USER_INVITED', entity_type: 'qops_user', entity_id: email, status: authorized ? 'success' : 'error', details: authorized ? `Invited ${email} as ${role}` : message, metadata: { source: 'ui', email, role, redirectTo } } } }];"
      }
    },
    {
      "id": "a3d97d8b-a45a-4866-bf89-c43986d32659",
      "name": "Is Authorized Admin Invite",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        896,
        96
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 3
          },
          "conditions": [
            {
              "id": "authorized",
              "leftValue": "={{ $json.authorized }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      }
    },
    {
      "id": "8dfd7eee-4f29-45d7-a586-57ac4286dd7d",
      "name": "Invite Supabase Auth User",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        1120,
