  "name": "Q-Ops Agent User Invite API",
  "description": "POST /webhook/users/invite endpoint. Requires active admin JWT, invites a Supabase Auth user with UI callback redirect query, upserts qops_users, and writes qops_audit_events.",
  "active": true,
  "isArchived": false,
  "nodes": [
    {
