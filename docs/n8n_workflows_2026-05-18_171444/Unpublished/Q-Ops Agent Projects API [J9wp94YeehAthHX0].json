    {
      "id": "f5f8bf83-1b80-4e3c-84a8-5e0d2c03398a",
      "name": "Map Projects Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ],
      "parameters": {
        "jsCode": "const projects = $input.all().map(i => i.json).filter(p => p && p.id).map(p => ({ id: p.id, name: p.name, description: p.description || '', owner: p.owner || 'Admin User', module: p.module || '', release: p.release || '', tags: Array.isArray(p.tags) ? p.tags : [], status: p.status || 'draft', createdAt: p.created_at, updatedAt: p.updated_at })); return [{ json: { projects } }];"
      }
    },
