      ],
      "parameters": {
        "url": "https://ifnznfspkjayhnooncrv.supabase.co/rest/v1/qops_projects",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpCustomAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "select",
