    {
      "id": "0ee53d88-a281-4eff-8c4e-96b0eebe2bbc",
      "name": "Prepare Project Upsert",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        224
      ],
      "parameters": {
        "jsCode": "const restBase = 'https://ifnznfspkjayhnooncrv.supabase.co/rest/v1'; const body = $('POST /projects').item.json.body || {}; const name = String(body.name || '').trim(); if (!name) throw new Error('Project name is required'); const existing = $input.all().map(i => i.json).find(p => p && p.id && String(p.name || '').toLowerCase() === name.toLowerCase()); const payload = { name, description: body.description || '', owner: body.owner || 'Admin User', module: body.module || '', release: body.release || '', tags: Array.isArray(body.tags) ? body.tags : [], status: body.status || 'draft', updated_at: new Date().toISOString() }; if (!existing) payload.created_at = new Date().toISOString(); return [{ json: { method: existing ? 'PATCH' : 'POST', url: existing ? `${restBase}/qops_projects?id=eq.${encodeURIComponent(existing.id)}` : `${restBase}/qops_projects`, payload, auditAction: existing ? 'PROJECT_UPDATED' : 'PROJECT_CREATED' } }];"
      }
    },
    {
      "id": "e3866c57-7e8e-47e4-bd28-dd855b546a6d",
      "name": "Upsert Project",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        672,
        224
      ],
      "parameters": {
        "method": "={{ $json.method }}",
        "url": "={{ $json.url }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpCustomAuth",
        "sendHeaders": true,
        "specifyHeaders": "json",
        "jsonHeaders": "{ \"Content-Type\": \"application/json\", \"Prefer\": \"return=representation\" }",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json.payload }}",
        "options": {}
      }
    },
    {
      "id": "4567c84f-678e-40b8-8017-5ecc7a76a427",
      "name": "Map Project Write Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        224
      ],
      "parameters": {
        "jsCode": "const p = $input.first().json; const action = $('Prepare Project Upsert').item.json.auditAction; return [{ json: { id: p.id, name: p.name, description: p.description || '', owner: p.owner || 'Admin User', module: p.module || '', release: p.release || '', tags: Array.isArray(p.tags) ? p.tags : [], status: p.status || 'draft', createdAt: p.created_at, updatedAt: p.updated_at, audit: { action, entity_type: 'project', entity_id: p.id, project_id: p.id, actor_name: 'n8n', status: 'success', details: `${action}: ${p.name}`, metadata: { source: 'ui', projectName: p.name } } } }];"
      }
    },
