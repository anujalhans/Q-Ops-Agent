    {
      "id": "0657ba78-adba-4095-bd47-aab6feb562ca",
      "name": "Map Audit Events Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        896
      ],
      "parameters": {
        "jsCode": "const explicitEvents = $items('Fetch Q-Ops Audit Events').map(i => i.json).filter(e => e && e.id).map(e => ({\n  id: e.id,\n  actor: e.actor_name || 'n8n',\n  action: e.action,\n  project: e.metadata?.projectName || e.project_id || '',\n  entity: e.entity_id || e.entity_type || '',\n  status: e.status || 'info',\n  timestamp: e.created_at,\n  details: e.details || '',\n  event: e.action\n}));\nconst metricEvents = $items('Fetch QA Job Metrics For Audit').map(i => i.json).filter(m => m && m.id).map(m => ({\n  id: `metric-${m.id}`,\n  actor: 'n8n',\n  action: m.event || 'JOB_EVENT',\n  project: m.project_name || '',\n  entity: m.job_id || '',\n  status: m.status === 'error' ? 'error' : m.event === 'JOB_COMPLETED' ? 'success' : 'info',\n  timestamp: m.created_at,\n  details: [m.pipeline, m.document_type, m.error_message].filter(Boolean).join(' | '),\n  event: m.event,\n  pipeline: m.pipeline,\n  jobId: m.job_id\n}));\nconst events = explicitEvents.concat(metricEvents).sort((a, b) => new Date(b.timestamp || 0) - new Date(a.timestamp || 0)).slice(0, 150);\nreturn [{ json: { events } }];"
      }
    },
