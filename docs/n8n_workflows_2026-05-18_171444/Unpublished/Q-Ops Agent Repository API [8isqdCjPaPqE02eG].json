        448,
        672
      ],
      "parameters": {
        "jsCode": "const documents = $input.all().map(i => i.json).filter(j => j && j.job_id).map(j => ({\n  id: j.job_id,\n  jobId: j.job_id,\n  projectName: j.input?.projectName || 'Unknown project',\n  documentType: j.input?.documentType || '',\n  artifactLabel: j.input?.documentType || '',\n  createdAt: j.created_at,\n  status: j.status,\n  url: j.output?.url || j.output?.confluenceUrl || '',\n  output: j.output || null\n}));\nreturn [{ json: { documents } }];"
