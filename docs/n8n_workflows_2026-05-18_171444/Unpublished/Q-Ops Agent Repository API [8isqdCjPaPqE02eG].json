    {
      "id": "7a395a24-55a7-44d8-a78c-0d2c8f72b4d6",
      "name": "Map Project Write Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        224
      ],
      "parameters": {
        "jsCode": "const p = $input.first().json;\nconst action = $('Prepare Project Upsert').item.json.auditAction;\nreturn [{ json: {\n  id: p.id,\n  name: p.name,\n  description: p.description || '',\n  owner: p.owner || 'Admin User',\n  module: p.module || '',\n  release: p.release || '',\n  tags: Array.isArray(p.tags) ? p.tags : [],\n  status: p.status || 'draft',\n  createdAt: p.created_at,\n  updatedAt: p.updated_at,\n  audit: { action, entity_type: 'project', entity_id: p.id, project_id: p.id, actor_name: 'n8n', status: 'success', details: `${action}: ${p.name}`, metadata: { source: 'ui' } }\n} }];"
