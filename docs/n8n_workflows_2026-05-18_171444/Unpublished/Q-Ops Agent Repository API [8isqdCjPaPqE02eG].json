    {
      "id": "426b0e91-00cc-45f3-9af8-98bf809bc019",
      "name": "Prepare Project Upsert",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        224
      ],
      "parameters": {
        "jsCode": "const body = $('POST /projects').item.json.body || {};\nconst name = String(body.name || '').trim();\nif (!name) throw new Error('Project name is required');\nconst existing = $input.all().map(i => i.json).find(p => p && p.id && String(p.name || '').toLowerCase() === name.toLowerCase());\nconst payload = {\n  name,\n  description: body.description || '',\n  owner: body.owner || 'Admin User',\n  module: body.module || '',\n  release: body.release || '',\n  tags: Array.isArray(body.tags) ? body.tags : [],\n  status: body.status || 'draft',\n  updated_at: new Date().toISOString()\n};\nif (!existing) payload.created_at = new Date().toISOString();\nreturn [{ json: {\n  method: existing ? 'PATCH' : 'POST',\n  url: existing ? `${supabaseUrl}/qops_projects?id=eq.${encodeURIComponent(existing.id)}` : `${supabaseUrl}/qops_projects`,\n  payload,\n  auditAction: existing ? 'PROJECT_UPDATED' : 'PROJECT_CREATED'\n} }];"
      }
    },
