        "jsCode": "const artifactId = $json.params?.artifactId || '';\nconst [jobId, fileKey] = artifactId.split(':');\nif (!jobId || !fileKey) throw new Error('Artifact id must be formatted as jobId:fileKey');\nreturn [{ json: { artifactId, jobId, fileKey } }];"
