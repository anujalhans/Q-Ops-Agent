      "name": "Wait for All Queries",
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "// Pull results from each parallel query by node name\nconst overviewRaw = $items(\"Query: Overview Stats\")[0]?.json || {};\nconst byDocTypeRaw = $items(\"Query: By Document Type\")[0]?.json;\nconst failureRateRaw = $items(\"Query: Failure Rate\")[0]?.json || {};\nconst recentJobsRaw = $items(\"Query: Recent Jobs\");\n\n// ✅ Overview — Supabase RPC returns the jsonb directly as the response object\nconst overview = {\n  totalJobsCompleted:          overviewRaw.totalJobsCompleted || 0,\n  totalDocumentsGenerated:     overviewRaw.totalDocumentsGenerated || 0,\n  totalIngestionJobsCompleted: overviewRaw.totalIngestionJobsCompleted || 0,\n  totalJobsFailed:             overviewRaw.totalJobsFailed || 0,\n  successRate:                 parseFloat(overviewRaw.successRate) || 100,\n  totalCostUsd:                parseFloat(overviewRaw.totalCostUsd) || 0,\n  avgCostPerDocument:          parseFloat(overviewRaw.avgCostPerDocument) || 0,\n  totalTokensConsumed:         parseInt(overviewRaw.totalTokensConsumed) || 0,\n  totalChunksIngested:         parseInt(overviewRaw.totalChunksIngested) || 0,\n  avgDurationMs:               parseInt(overviewRaw.avgDurationMs) || 0\n};\n\n// ✅ By Document Type — RPC returns jsonb array\nlet byDocumentType = [];\nif (Array.isArray(byDocTypeRaw)) {\n  byDocumentType = byDocTypeRaw;\n} else if (byDocTypeRaw && typeof byDocTypeRaw === 'object') {\n  // Sometimes Supabase wraps single results\n  byDocumentType = [byDocTypeRaw];\n}\n\n// ✅ Failure Rate — RPC returns { generation: 0.0, ingestion: 0.0 }\nconst failureRate = {\n  generation: parseFloat(failureRateRaw.generation) || 0,\n  ingestion:  parseFloat(failureRateRaw.ingestion) || 0\n};\n\n// ✅ Recent Jobs — direct table query returns array of items\nconst recentJobs = recentJobsRaw.map(item => ({\n  jobId:            item.json.job_id,\n  projectName:      item.json.project_name,\n  documentType:     item.json.document_type,\n  pipeline:         item.json.pipeline,\n  status:           item.json.status,\n  durationMs:       item.json.duration_ms,\n  wordCount:        item.json.word_count,\n  tokensTotal:      item.json.tokens_total,\n  estimatedCostUsd: parseFloat(item.json.estimated_cost_usd) || 0,\n  createdAt:        item.json.created_at\n}));\n\n// ✅ Final response\nreturn [\n  {\n    json: {\n      overview,\n      byDocumentType,\n      failureRate,\n      recentJobs,\n      meta: {\n        generatedAt:  new Date().toISOString(),\n        dateFrom:     $('Set Default Params').item.json.dateFrom,\n        pipeline:     $('Set Default Params').item.json.pipeline,\n        daysRequested: $('Set Default Params').item.json.days\n      }\n    }\n  }\n];"
      },
